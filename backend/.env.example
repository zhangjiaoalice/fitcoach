# 复制本文件为 .env 后填入真实值。.env 不提交 Git（见 7.2 安全要求）。

# --- 数据库 ---
# 注意端口 5433，对应 docker-compose 里映射到宿主机的端口
DATABASE_URL=postgresql+asyncpg://fitcoach:fitcoach_dev_pwd@localhost:5433/fitcoach

# --- JWT (M1) ---
# 生产环境务必换成随机长字符串：python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=dev_secret_change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Moonshot / Kimi (M4) ---
# Key 只保存在服务端，前端绝不直连（见 7.2）
MOONSHOT_API_KEY=sk-your-key-here
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k
