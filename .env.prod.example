# FitCoach 生产环境变量样本
# 复制到 .env.prod 并填真实值,.env.prod 永远不进 Git
#
# 部署命令:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# ========== 数据库 ==========
POSTGRES_USER=fitcoach
POSTGRES_PASSWORD=换成强随机密码_32位以上
POSTGRES_DB=fitcoach

# ========== JWT ==========
# 生成: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=换成 64 位十六进制随机串
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========== Kimi ==========
MOONSHOT_API_KEY=sk-你的真实Kimi Key
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k3
